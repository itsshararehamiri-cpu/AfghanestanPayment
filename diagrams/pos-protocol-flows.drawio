          <mxGeometry x="1300" y="330" width="220" height="40" as="geometry" />
        </mxCell>

        <!-- Main happy-path / decline column -->
        <mxCell id="f1" value="POS: Build financial request (1100)&lt;br&gt;DE3 processing code, DE4 amount (12-digit minor units), DE11 STAN,&lt;br&gt;DE24 or DE48 tag 002 function code, DE35/DE52 for card txns, DE41/DE42 ids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="POS: Register SAF entry (status = R)&lt;br&gt;original STAN, amount and processing/function-code mapping saved before send" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="Switch: send request to KAREN&lt;br&gt;TPDU 60 18 19 12 70" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="Validation: switch checks MAC, bitmap,&lt;br&gt;business rules and terminal profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="Response received&lt;br&gt;before timeout?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="DE39 = 000&lt;br&gt;(approved)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="Declined: normalize response code,&lt;br&gt;show mapped text (DE39 / messages.failed);&lt;br&gt;discard SAF entry — no reversal needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="380" y="690" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="Approved: read DE48 (tag 019 balance /&lt;br&gt;tag 049 holder name), save report, clear SAF entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#10739e;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- Timeout / reversal column -->
        <mxCell id="f10" value="No response / connect, send or receive error&lt;br&gt;SAF entry stays status = R" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="720" y="520" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f11" value="POS: queue processor picks pending SAF item&lt;br&gt;original STAN, amount and mapping preserved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="720" y="640" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f12" value="Switch: build and send Reversal (1420)&lt;br&gt;same STAN / DE4 amount / function-code mapping / DE41-DE42;&lt;br&gt;DE28, DE29, DE30 and DE72 stay absent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="760" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f13" value="Validation: switch matches reversal to&lt;br&gt;original transaction via STAN + RRN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="720" y="890" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f14" value="1430 response&lt;br&gt;approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="740" y="1000" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f15" value="Reversal confirmed —&lt;br&gt;clear SAF entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#10739e;" vertex="1" parent="1">
          <mxGeometry x="720" y="1160" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f16" value="Keep status = R —&lt;br&gt;requeue for next flush cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1160" width="260" height="80" as="geometry" />
        </mxCell>

